.code-text {
  color: #1d4ed8;
  font-weight: 700;
}

.status-text {
  color: #2563eb;
  font-weight: 700;
}

.input {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  margin: 16rpx 0;
  border: 1rpx solid #dbeafe;
  border-radius: 20rpx;
  background: #f8fbff;
  font-size: 26rpx;
  color: #0f172a;
}

.textarea {
  min-height: 180rpx;
}

.button-primary,
.button-secondary {
  width: 100%;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 24rpx 0;
  margin-top: 16rpx;
}

.button-primary {
  background: linear-gradient(135deg, #0052d9, #2563eb);
  color: #ffffff;
}

.button-primary[disabled] {
  background: linear-gradient(135deg, #cbd5e1, #cbd5e1);
  color: #ffffff;
}

.button-secondary {
  background: #ffffff;
  color: #0f172a;
  border: 1rpx solid #d7e4ff;
}

.clickable {
  color: #1d4ed8;
}

.track-map {
  width: 100%;
  height: 520rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-top: 12rpx;
}

.map-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #475569;
  font-size: 24rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.legend-start {
  background: #16a34a;
}

.legend-end {
  background: #ef4444;
}

.legend-stay {
  background: #f59e0b;
}

.timeline-list {
  margin-top: 8rpx;
}

.timeline-item {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding: 0 0 28rpx 8rpx;
}

.timeline-line {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  bottom: -8rpx;
  width: 2rpx;
  background: #dbeafe;
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-dot {
  position: relative;
  z-index: 1;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex: none;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx rgba(59, 130, 246, 0.15);
}

.timeline-start {
  background: #16a34a;
}

.timeline-track {
  background: #2563eb;
}

.timeline-stay {
  background: #f59e0b;
}

.timeline-snapshot {
  background: #f59e0b;
}

.timeline-end {
  background: #ef4444;
}

.timeline-reward {
  background: #7c3aed;
}

.timeline-content {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.timeline-time {
  margin-top: 8rpx;
  color: #1d4ed8;
  font-size: 24rpx;
}

.timeline-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-note {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.debug-status-success {
  color: #15803d;
  font-weight: 700;
}

.debug-status-danger {
  color: #dc2626;
  font-weight: 700;
}
