.picker-field {
  min-height: 84rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #d7e4ff;
  color: #102a43;
  font-size: 28rpx;
  line-height: 44rpx;
}

.annual-map {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-top: 12rpx;
}

.analytics-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.analytics-row:last-child {
  border-bottom: none;
}

.analytics-row-title {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 600;
}

.analytics-row-value {
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
}
