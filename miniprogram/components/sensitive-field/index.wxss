.sensitive-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sensitive-label {
  color: #64748b;
  font-size: 26rpx;
}

.sensitive-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.sensitive-value {
  flex: 1;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}

.sensitive-toggle {
  flex: none;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
  font-size: 24rpx;
}
