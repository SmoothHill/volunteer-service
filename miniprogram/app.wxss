page {
  background:
    radial-gradient(circle at top right, rgba(0, 82, 217, 0.12), transparent 34%),
    linear-gradient(180deg, #f6f9ff 0%, #f4f7fb 36%, #eef3f9 100%);
  color: #1f2937;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card,
.card {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16rpx);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
}

.hero-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(231, 240, 255, 0.96));
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.sub-title {
  margin-top: 10rpx;
  color: #5b6b82;
  font-size: 25rpx;
  line-height: 1.6;
}

.meta {
  color: #475569;
  font-size: 24rpx;
  margin-top: 12rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
  color: #102a43;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f8fbff;
  border: 1rpx solid #d7e4ff;
  border-radius: 22rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  color: #102a43;
}

.textarea {
  min-height: 180rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat-item {
  padding: 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
}

.stat-label {
  color: #6b7a90;
  font-size: 22rpx;
}

.stat-value {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 700;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.button-row .t-button {
  flex: 1;
  min-width: 220rpx;
}

.button-row .native-btn {
  flex: 1;
  min-width: 220rpx;
}

.native-btn {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid #d7e4ff;
  background: #ffffff;
  color: #102a43;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.native-btn::after {
  border: none;
}

.native-btn.primary {
  background: #0052d9;
  color: #ffffff;
  border-color: #0052d9;
}

.native-btn.outline {
  background: #ffffff;
  color: #0052d9;
  border-color: #c6d8ff;
}

.native-btn.warning {
  background: #fff7ed;
  color: #c2410c;
  border-color: #fed7aa;
}

.native-btn.danger {
  background: #fff1f2;
  color: #dc2626;
  border-color: #fecdd3;
}

.native-tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.native-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.native-tabs-home {
  width: max-content;
  min-width: 100%;
  padding-bottom: 6rpx;
  flex-wrap: nowrap;
}

.native-tab {
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: #f8fbff;
  border: 1rpx solid #d7e4ff;
  color: #516174;
  font-size: 26rpx;
  line-height: 1.2;
}

.native-tabs-home .native-tab {
  flex: 0 0 auto;
  white-space: nowrap;
}

.native-tab-active {
  background: #0052d9;
  border-color: #0052d9;
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(0, 82, 217, 0.18);
}

.tag-chip {
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.tag-primary {
  color: #0052d9;
  background: rgba(0, 82, 217, 0.1);
}

.tag-success {
  color: #059669;
  background: rgba(16, 185, 129, 0.12);
}

.tag-warning {
  color: #ea580c;
  background: rgba(249, 115, 22, 0.12);
}

.tag-default {
  color: #475569;
  background: #eef3fb;
}

.tag-danger {
  color: #dc2626;
  background: #fff1f2;
}

.surface {
  background: #f8fbff;
  border-radius: 24rpx;
  padding: 22rpx;
  margin-top: 18rpx;
  border: 1rpx solid #e0e9f8;
}

.empty-state {
  text-align: center;
  padding: 44rpx 24rpx;
  color: #6b7a90;
  font-size: 24rpx;
}

.tabs-block {
  margin-top: 24rpx;
}

.tabs-panel {
  padding-top: 22rpx;
}

.list-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #e6edf8;
}

.list-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #102a43;
}

.accent-note {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, rgba(0, 82, 217, 0.08), rgba(20, 184, 166, 0.08));
  color: #1d4ed8;
  font-size: 23rpx;
  line-height: 1.6;
}
